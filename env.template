# Shopify Theme Environment Configuration
# Copy this file to .env and fill in your actual values

# Development Environment
SHOPIFY_DEV_STORE=your-dev-store-name
SHOPIFY_DEV_THEME_ID=123456789

# Staging Environment (Optional)
SHOPIFY_STAGING_STORE=your-staging-store-name
SHOPIFY_STAGING_THEME_ID=987654321

# Production Environment
SHOPIFY_PROD_STORE=your-production-store-name
SHOPIFY_PROD_THEME_ID=456789123

# Shopify CLI Theme Token (get from: shopify theme token)
SHOPIFY_CLI_THEME_TOKEN=your-theme-token-here

# Additional Configuration
NODE_ENV=development
SHOPIFY_CLI_VERSION=3.50.0
